
@article{dehlaghi-ghadim_icssim-framework_2023,
	title = {{ICSSIM}-{A} {Framework} for {Building} {Industrial} {Control} {Systems} {Security} {Simulation} {Testbeds}},
	volume = {148},
	issn = {01663615},
	url = {http://arxiv.org/abs/2210.13325},
	doi = {10.1016/j.compind.2023.103906},
	abstract = {With the advent of smart industry, Industrial Control Systems (ICS) are increasingly using Cloud, IoT, and other services to meet Industry 4.0 targets. The connectivity inherent in these services exposes such systems to increased cybersecurity risks. To protect ICSs against cyberattacks, intrusion detection systems and intrusion prevention systems empowered by machine learning are used to detect abnormal behavior of the systems. Operational ICSs are not safe environments to research intrusion detection systems due to the possibility of catastrophic risks. Therefore, realistic ICS testbeds enable researchers to analyze and validate their intrusion detection algorithms in a controlled environment. Although various ICS testbeds have been developed, researchers’ access to a low-cost, adaptable, and customizable testbed that can accurately simulate industrial control systems and suits security research is still an important issue.},
	language = {en},
	urldate = {2024-07-15},
	journal = {Computers in Industry},
	author = {Dehlaghi-Ghadim, Alireza and Balador, Ali and Moghadam, Mahshid Helali and Hansson, Hans and Conti, Mauro},
	month = jun,
	year = {2023},
	note = {arXiv:2210.13325 [cs]},
	keywords = {Computer Science - Cryptography and Security},
	pages = {103906},
	annote = {Comment: 43 pages, 13 figures},
	file = {Dehlaghi-Ghadim et al. - 2023 - ICSSIM-A Framework for Building Industrial Control.pdf:C\:\\Users\\ejubb\\Zotero\\storage\\V43JRSCM\\Dehlaghi-Ghadim et al. - 2023 - ICSSIM-A Framework for Building Industrial Control.pdf:application/pdf},
}
